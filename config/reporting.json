{
  "schema_version": "1.0.0",
  "mastery": {
    "ewma_alpha": 0.3,
    "scope": "knowledge_point_cross_bank",
    "weak_threshold": 0.60,
    "weak_min_attempts": 3,
    "mastered_threshold": 0.85,
    "mastered_min_attempts": 5
  },
  "trend": {
    "window": 5,
    "rising_above": 0.05,
    "falling_below": -0.05
  },
  "single_report": {
    "weak_point_top_n": 3,
    "include_each_question": true,
    "require_action_bound_to_knowledge_point": true
  },
  "weakness_analysis": {
    "enabled": true,
    "endpoint": "http://127.0.0.1:11435/v1/chat/completions",
    "model": "qwen-local",
    "model_identifier": "qwen3.5:4b-q4_K_M",
    "deployment": "local llama.cpp OpenAI-compatible API",
    "server_version": "llama-server 0.8.0-dev (commit 39febd2ad)",
    "max_chars": 100,
    "max_wrong_samples": 4,
    "max_tokens": 220,
    "temperature": 0.2,
    "timeout_seconds": 60
  },
  "stage_report": {
    "trigger_every_practices": 5,
    "require_trend_slope": true,
    "require_stability_stddev": true,
    "require_cross_bank_notice": true,
    "cross_bank_notice_required_when_bank_count_gte": 2
  }
}
