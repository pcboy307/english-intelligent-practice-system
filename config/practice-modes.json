{
  "schema_version": "2.0.0",
  "modes": {
    "30": {
      "duration_minutes": 30,
      "passage_composition": {
        "cloze": 1,
        "grammar_fill": 1,
        "reading_or_gap_fill": 1
      }
    }
  },
  "selection_policy": {
    "rules": [
      {
        "priority": 1,
        "description": "Select one cloze, one grammar-fill and one reading or seven-choice passage; prefer passages not yet covered by the student."
      },
      {
        "priority": 2,
        "description": "When Rule 1 ties, prefer a combination with three distinct topics."
      }
    ],
    "candidate_order": [
      "highest_unseen_passage_count",
      "highest_distinct_topic_count"
    ],
    "coverage_source": "submitted_or_expired_reports_for_same_student_and_bank",
    "abandoned_sessions_count_as_covered": false,
    "error_tags_used_for_selection": false,
    "history_weights_used_for_selection": false,
    "book_distribution_used_for_selection": false,
    "difficulty_distribution_used_for_selection": false,
    "grammar_tag_repetition_used_for_selection": false,
    "knowledge_point_repetition_used_for_selection": false,
    "error_pool_ratio_used_for_selection": false,
    "active_passage_conflict_used_for_selection": false
  },
  "bank_scope": {
    "source": "session.bank_id",
    "allow_cross_bank_sampling": false,
    "active_bank_required_for_new_session": true
  }
}
