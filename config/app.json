{
  "schema_version": "1.0.0",
  "student_identity": {
    "storage_key": "device_student_id",
    "header": "X-Student-Id",
    "uuid_version": 4,
    "web_storage": "localStorage",
    "native_storage": "expo-secure-store",
    "web_security_level": "local_demo_acceptable",
    "native_secure_store_required": true
  },
  "web_layout": {
    "mobile_max_width": 480,
    "desktop_breakpoint": 768,
    "desktop_max_width": 960,
    "body_max_width": 760,
    "center_horizontally": true,
    "color_scheme": "light",
    "body_background_token": "pageBackground",
    "body_text_token": "primaryText"
  },
  "time_authority": "server_deadline",
  "foreground_recalibration_required": true,
  "offline_answer_persistence": true,
  "answer_available_before_submit": false,
  "data_clear_requires_confirmation": true,
  "data_clear_scope": ["local_cache", "backend_student_data"]
}
