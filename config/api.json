{
  "schema_version": "1.0.0",
  "prefix": "/api/v1",
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "web_frontend": {
    "host": "localhost",
    "port": 8081
  },
  "database": {
    "expected_port": 15432
  },
  "cors": {
    "allow_origins": [
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ],
    "allow_credentials": false,
    "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allow_headers": [
      "Content-Type",
      "X-Student-Id",
      "X-Admin-Token",
      "Idempotency-Key"
    ],
    "wildcard_allowed": false
  },
  "student_header": "X-Student-Id",
  "max_page_size": 100,
  "default_preview_questions": 5,
  "timeout_seconds": {
    "paper_generation": 2,
    "grading_and_report": 5
  }
}
