{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.english-practice/schemas/cloze-rewrite-batch.json",
  "title": "Co-designed cloze passage and question batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_words", "passage", "questions"],
  "properties": {
    "target_words": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"type": "string", "minLength": 1}
    },
    "passage": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_index",
          "stem",
          "options",
          "answer",
          "context_clue",
          "clue_argument",
          "knowledge_points",
          "grammar_tags",
          "book_source",
          "difficulty"
        ],
        "properties": {
          "question_index": {"type": "integer", "minimum": 1, "maximum": 15},
          "stem": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1}
          },
          "answer": {"type": "string", "minLength": 1},
          "context_clue": {"type": "string", "minLength": 1},
          "clue_argument": {"type": "string", "minLength": 1},
          "cloze_tier": {"enum": ["easy", "medium", "hard"]},
          "knowledge_points": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "grammar_tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "book_source": {"type": "string", "minLength": 1},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
          "invalid": {"type": "boolean"},
          "invalid_reason": {"type": "string"}
        }
      }
    }
  }
}
