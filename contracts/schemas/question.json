{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.english-practice/schemas/question.json",
  "title": "Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bank_id",
    "type",
    "passage_group_id",
    "passage",
    "word_count",
    "stem",
    "options",
    "answer",
    "presentation",
    "explanation",
    "knowledge_points",
    "grammar_tags",
    "book_source",
    "book_tag",
    "difficulty",
    "out_of_scope_flags",
    "status",
    "batch_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "bank_id": {"type": "string", "format": "uuid"},
    "type": {"enum": ["cloze", "grammar_fill", "reading", "gap_fill"]},
    "passage_group_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "passage": {"type": "string", "minLength": 1},
    "word_count": {"type": "integer", "minimum": 1, "maximum": 250},
    "stem": {"type": "string", "minLength": 1},
    "options": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 7,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "answer": {"$ref": "./common.json#/$defs/answerValue"},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "passage_order", "question_order", "blank_label", "option_layout"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["cloze_single_choice", "passage_single_choice", "seven_choice", "reading_single_choice"]
        },
        "passage_order": {"type": "integer", "minimum": 1},
        "question_order": {"type": "integer", "minimum": 1},
        "blank_label": {"type": "string", "minLength": 1},
        "option_layout": {"type": "string", "enum": ["A-D", "A-G"]}
      }
    },
    "explanation": {"type": "string", "minLength": 1},
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "grammar_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "relative_clauses_defining",
          "relative_clauses_non_defining",
          "passive_voice_tenses",
          "past_participle_nonfinite",
          "v_ing_nonfinite",
          "noun_clauses",
          "adverbial_clauses",
          "subjunctive_basic_if",
          "subjunctive_basic_should",
          "partial_inversion_basic",
          "cleft_basic",
          "tense_system",
          "subject_verb_agreement",
          "articles",
          "prepositions",
          "pronouns",
          "conjunctions",
          "word_formation",
          "comparatives_superlatives",
          "with_compound",
          "infinitive_nonfinite"
        ]
      }
    },
    "book_source": {
      "type": "string",
      "minLength": 1,
      "description": "教材与单元来源；必须能且只能解析出一个 book_tag。"
    },
    "book_tag": {"$ref": "./common.json#/$defs/bookTag"},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
    "out_of_scope_flags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "status": {"type": "string", "enum": ["draft", "reviewed", "published", "archived"]},
    "batch_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "context_clue": {"type": "string", "minLength": 1},
    "clue_argument": {"type": "string", "minLength": 1},
    "invalid": {"type": "boolean"},
    "invalid_reason": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "grammar_fill"}}},
      "then": {
        "properties": {
          "options": {"type": "array", "minItems": 4, "maxItems": 4},
          "answer": {"type": "string"}
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "cloze"}}},
      "then": {"properties": {"options": {"type": "array", "minItems": 4, "maxItems": 4}}}
    },
    {
      "if": {"properties": {"type": {"const": "gap_fill"}}},
      "then": {"properties": {"options": {"type": "array", "minItems": 7, "maxItems": 7}}}
    },
    {
      "if": {"properties": {"type": {"const": "reading"}}},
      "then": {"properties": {"options": {"type": "array", "minItems": 4, "maxItems": 4}}}
    }
  ]
}
