{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.english-practice/contracts/schemas/bank-import-package.json",
  "title": "Question bank import package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "name",
    "target_size",
    "difficulty_profile",
    "generated_at",
    "composition",
    "passages"
  ],
  "properties": {
    "format_version": {
      "type": "string",
      "enum": ["bank-v1", "m26-v1"],
      "description": "m26-v1 enforces the complete 72-passage / 500-question quota."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "target_size": {
      "type": "integer",
      "minimum": 1
    },
    "difficulty_profile": {
      "type": "string",
      "enum": ["standard", "foundation", "advanced"]
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "composition": {
      "$ref": "#/$defs/composition"
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/passage"
      }
    }
  },
  "$defs": {
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloze", "grammar_fill", "reading", "gap_fill"],
      "properties": {
        "cloze": { "type": "integer", "minimum": 0 },
        "grammar_fill": { "type": "integer", "minimum": 0 },
        "reading": { "type": "integer", "minimum": 0 },
        "gap_fill": { "type": "integer", "minimum": 0 }
      }
    },
    "options": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 7,
          "propertyNames": {
            "pattern": "^[A-G]$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "answer", "explanation", "grammar_tags"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "stem": { "type": "string", "minLength": 1 },
        "options": {
          "$ref": "#/$defs/options"
        },
        "answer": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "knowledge_points": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "grammar_tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "book_source": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "evidence_sentence": { "type": "string", "minLength": 1 },
        "reading_type": {
          "type": "string",
          "enum": ["main_idea", "detail", "inference", "word_meaning", "attitude"]
        },
        "grammar_category": { "type": "string", "minLength": 1 },
        "cohesion_type": { "type": "string", "minLength": 1 },
        "context_clue": { "type": "string", "minLength": 1 },
        "clue_argument": { "type": "string", "minLength": 1 },
        "near_synonym_calibration": { "type": "boolean" }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "passage_group_id",
        "topic",
        "book_source",
        "difficulty",
        "passage",
        "questions"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cloze", "grammar_fill", "reading", "gap_fill"]
        },
        "passage_group_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "topic": { "type": "string", "minLength": 1 },
        "book_source": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "word_count": { "type": "integer", "minimum": 1 },
        "flesch_reading_ease": { "type": "number" },
        "passage": { "type": "string", "minLength": 1 },
        "options": {
          "$ref": "#/$defs/options"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "validation_profile": {
          "type": "string",
          "enum": ["m2", "m26", "stored"],
          "description": "stored is emitted by database export; structural import checks still apply, while generation-only placeholder and semantic gates are not repeated."
        },
        "generation_observations": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "cloze" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "questions": { "minItems": 15, "maxItems": 15 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "grammar_fill" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "questions": { "minItems": 10, "maxItems": 10 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "reading" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "questions": { "minItems": 4, "maxItems": 4 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "gap_fill" } },
            "required": ["type"]
          },
          "then": {
            "required": ["options"],
            "properties": {
              "questions": { "minItems": 5, "maxItems": 5 }
            }
          }
        }
      ]
    }
  }
}
