{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.english-practice/schemas/cloze-passage-design.json",
  "title": "Coherent cloze passage with synchronized blank design",
  "type": "object",
  "additionalProperties": false,
  "required": ["sentences", "target_words", "complex_structures"],
  "properties": {
    "sentences": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 35}
    },
    "target_words": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"type": "string", "pattern": "^[A-Za-z]+$"}
    },
    "complex_structures": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentence_index", "structure_type", "evidence"],
        "properties": {
          "sentence_index": {"type": "integer", "minimum": 1, "maximum": 16},
          "structure_type": {
            "enum": [
              "relative_clause",
              "adverbial_clause",
              "noun_clause",
              "participial_phrase",
              "infinitive_phrase"
            ]
          },
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
