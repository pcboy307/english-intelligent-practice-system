{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.english-practice/schemas/session.json",
  "title": "Practice session without answers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "bank_id",
    "bank_name",
    "bank_version",
    "duration_minutes",
    "status",
    "items",
    "composition_note",
    "deadline",
    "server_time",
    "remaining_seconds",
    "progress"
  ],
  "properties": {
    "session_id": {"type": "string", "format": "uuid"},
    "bank_id": {"type": "string", "format": "uuid"},
    "bank_name": {"type": "string", "minLength": 1},
    "bank_version": {"type": "string", "minLength": 1},
    "duration_minutes": {"type": "integer", "enum": [30, 60]},
    "status": {"type": "string", "enum": ["in_progress", "submitted", "expired"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sessionItem"}
    },
    "composition_note": {"$ref": "#/$defs/compositionNote"},
    "deadline": {"type": "string", "format": "date-time"},
    "server_time": {"type": "string", "format": "date-time"},
    "remaining_seconds": {"type": "integer", "minimum": 0},
    "progress": {
      "type": "object",
      "required": ["answered", "total"],
      "properties": {
        "answered": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sessionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "type",
        "passage_group_id",
        "passage",
        "stem",
        "options",
        "saved_answer",
        "presentation_mode",
        "blank_label",
        "passage_order",
        "question_order",
        "book_tag"
      ],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["cloze", "grammar_fill", "reading", "gap_fill"]},
        "passage_group_id": {"type": "string", "minLength": 1},
        "passage": {"type": "string", "minLength": 1},
        "stem": {"type": "string", "minLength": 1},
        "options": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "saved_answer": {
          "oneOf": [
            {"type": "null"},
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "presentation_mode": {
          "type": "string",
          "enum": ["cloze_single_choice", "passage_single_choice", "seven_choice", "reading_single_choice"]
        },
        "blank_label": {"type": "string", "minLength": 1},
        "passage_order": {"type": "integer", "minimum": 1},
        "question_order": {"type": "integer", "minimum": 1},
        "book_tag": {"enum": ["必修", "选必一", "选必二", "跨册"]}
      }
    },
    "compositionNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bank_name",
        "session_kind",
        "question_type_counts",
        "topics",
        "assembly_log"
      ],
      "properties": {
        "bank_name": {"type": "string"},
        "session_kind": {"const": "practice"},
        "question_type_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "assembly_log": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
