{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.english-practice/schemas/generation-batch.json",
  "title": "Generated explanation batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["explanations"],
  "properties": {
    "explanations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_index", "explanation"],
        "properties": {
          "question_index": {
            "type": "integer",
            "minimum": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
